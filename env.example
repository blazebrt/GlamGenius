# GlamGenius — Personal Appearance Operating System
# Copy to backend/.env. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Public anon JWT. Safe to expose to the frontend.
SUPABASE_ANON_KEY=your_anon_key_here
# SERVER-ONLY. Never expose to the frontend or ship in Expo bundles.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT issuer used in access tokens. Defaults to ${SUPABASE_URL}/auth/v1 when empty.
SUPABASE_JWT_ISSUER=
# JWKS endpoint for asymmetric (RS256/ES256) verification. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when empty.
SUPABASE_JWKS_URL=

# Private bucket that holds inventory media.
SUPABASE_STORAGE_BUCKET=glamgenius-media

# Sync + async URL for the same Supabase Postgres. Both are supported by
# the app; Alembic uses the sync driver, runtime uses asyncpg.
# Direct: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_URL=postgresql://postgres:change_me@db.your-project.supabase.co:5432/postgres
# Connection-pool settings for the deployed API process.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ECHO=false

# ---------------------------------------------------------------------------
# Optional admin bootstrap
# ---------------------------------------------------------------------------
# Comma-separated list of Supabase Auth user UUIDs treated as admins. The
# first user should be created through the Supabase dashboard, then their
# UUID added here.
SUPABASE_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro
AI_TIMEOUT_SECONDS=45
AI_COST_PER_1K_INPUT_USD=0.0003
AI_COST_PER_1K_OUTPUT_USD=0.0025
MAX_IMAGE_BASE64_CHARS=12000000

# ---------------------------------------------------------------------------
# CORS + observability
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Consent
# ---------------------------------------------------------------------------
REQUIRE_ANALYSIS_CONSENT=true
CONSENT_VERSION=2026-01-01

# ---------------------------------------------------------------------------
# Beta usage controls (NON-PAYMENT abuse & cost limits)
# ---------------------------------------------------------------------------
# GlamGenius is a private beta. These are cost & abuse controls, NOT plans.
# Failed AI work is not counted. Idempotent retries are not double-counted.
BETA_AI_REQUESTS_PER_HOUR=60
BETA_SCAN_LIMIT_PER_MONTH=60
BETA_STYLE_LIMIT_PER_MONTH=60
BETA_SHOPPING_CHECK_LIMIT_PER_MONTH=60

# ---------------------------------------------------------------------------
# Invite-only access
# ---------------------------------------------------------------------------
# When "true", registration requires a valid invite code. Setting this to
# "false" in development lets you sign up freely; the production default
# stays true.
INVITE_REQUIRED=true

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Production: supabase. Tests: local.
MEDIA_STORAGE_BACKEND=supabase
MEDIA_LOCAL_ROOT=/data/media
MEDIA_MAX_BYTES=8388608
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp
# TTL of a signed download URL, in seconds.
MEDIA_SIGNED_URL_TTL_SECONDS=300
# Never enable local media storage in production or staging.
MEDIA_ALLOW_LOCAL_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Deployment tier
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Comma-separated flag keys switched on at boot. The database table
# overrides these at runtime.
V2_FEATURES=v2_profile,v2_scan,v2_quiz,v2_inventory,v2_recommendations,v2_shopping_decisions,v2_today,v2_planner,v2_routines,v2_progress,v2_media,v2_privacy,v2_consent,v2_ai_gateway


# ---------------------------------------------------------------------------
# Expo / frontend
# ---------------------------------------------------------------------------
# These live in `frontend/.env`, not `backend/.env`, because they must be
# baked into the Expo bundle. Only public values ship here — never the
# service-role key.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Optional mobile crash reporting. Empty disables frontend Sentry safely.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Public policy and support links (required in staging/production)
# ---------------------------------------------------------------------------
# Keep the safe placeholder locally. Production validation rejects placeholder values.
PRIVACY_POLICY_URL=https://glamgenius.placeholder/privacy
SUPPORT_URL=https://glamgenius.placeholder/support

# ---------------------------------------------------------------------------
# Google Calendar (optional; disabled unless explicitly enabled)
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ENABLED=false
# OAuth web callback registered with Google. Required only when enabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Fixed application return URI. Do not add query parameters or fragments.
GOOGLE_CALENDAR_APP_RETURN_URI=glamgenius://calendar-result
# Refresh tokens remain in Supabase Vault; no plaintext fallback is supported.
GOOGLE_CALENDAR_CREDENTIAL_STORE=disabled
GOOGLE_CALENDAR_STATE_TTL_SECONDS=600
GOOGLE_CALENDAR_INITIAL_HORIZON_DAYS=90
GOOGLE_CALENDAR_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Live weather and air quality (optional; disabled by default)
# ---------------------------------------------------------------------------
# OPEN_METEO_MODE: disabled, evaluation (development only), or commercial.
# Commercial mode requires OPEN_METEO_API_KEY in staging/production.
LIVE_ENVIRONMENT_PROVIDER=
OPEN_METEO_MODE=disabled
OPEN_METEO_API_KEY=
OPEN_METEO_TIMEOUT_SECONDS=5
ENVIRONMENT_CACHE_TTL_SECONDS=3600
ENVIRONMENT_STALE_MAX_SECONDS=21600

# ---------------------------------------------------------------------------
# Notification worker
# ---------------------------------------------------------------------------
# Native push is opt-in. The app needs an EAS/Expo project ID in build config
# for device registration; do not invent one here. A host scheduler must run:
#   python -m app.workers.notifications
# once per hour in production.
