# GlamGenius — Personal Appearance Operating System
# Copy to backend/.env. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Public anon JWT. Safe to expose to the frontend.
SUPABASE_ANON_KEY=your_anon_key_here
# SERVER-ONLY. Never expose to the frontend or ship in Expo bundles.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT issuer used in access tokens. Defaults to ${SUPABASE_URL}/auth/v1 when empty.
SUPABASE_JWT_ISSUER=
# JWKS endpoint for asymmetric (RS256/ES256) verification. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when empty.
SUPABASE_JWKS_URL=
# Legacy HS256 fallback. Only used when JWKS returns no matching key.
# Project Settings → API → JWT Settings → "JWT Secret".
SUPABASE_JWT_SECRET=
# Private bucket that holds inventory media.
SUPABASE_STORAGE_BUCKET=glamgenius-media

# Sync + async URL for the same Supabase Postgres. Both are supported by
# the app; Alembic uses the sync driver, runtime uses asyncpg.
# Direct: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_URL=postgresql://postgres:change_me@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Optional admin bootstrap
# ---------------------------------------------------------------------------
# Comma-separated list of Supabase Auth user UUIDs treated as admins. The
# first user should be created through the Supabase dashboard, then their
# UUID added here.
SUPABASE_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro

# ---------------------------------------------------------------------------
# CORS + observability
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Consent
# ---------------------------------------------------------------------------
REQUIRE_ANALYSIS_CONSENT=true
CONSENT_VERSION=2026-01-01

# ---------------------------------------------------------------------------
# Beta usage controls (NON-PAYMENT abuse & cost limits)
# ---------------------------------------------------------------------------
# GlamGenius is a private beta. These are cost & abuse controls, NOT plans.
# Failed AI work is not counted. Idempotent retries are not double-counted.
BETA_AI_REQUESTS_PER_HOUR=60
BETA_SCAN_LIMIT_PER_MONTH=60
BETA_STYLE_LIMIT_PER_MONTH=60
BETA_SHOPPING_CHECK_LIMIT_PER_MONTH=60

# ---------------------------------------------------------------------------
# Invite-only access
# ---------------------------------------------------------------------------
# When "true", registration requires a valid invite code. Setting this to
# "false" in development lets you sign up freely; the production default
# stays true.
INVITE_REQUIRED=true

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Production: supabase. Tests: local.
MEDIA_STORAGE_BACKEND=supabase
MEDIA_LOCAL_ROOT=/data/media
MEDIA_MAX_BYTES=8388608
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp
# TTL of a signed download URL, in seconds.
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Deployment tier
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Comma-separated flag keys switched on at boot. The database table
# overrides these at runtime.
V2_FEATURES=v2_profile,v2_scan,v2_quiz,v2_inventory,v2_recommendations,v2_shopping_decisions,v2_today,v2_planner,v2_routines,v2_progress,v2_media,v2_privacy,v2_consent,v2_ai_gateway
