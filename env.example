# GlamGenius — Personal Stylist & Skin/Hair Wellness Coach
# Copy to backend/.env (NEVER commit real secrets)

MONGO_URL=mongodb://mongo:27017
DB_NAME=glamgenius

# Server-side only — do NOT put this in frontend or EXPO_PUBLIC_* vars
GEMINI_API_KEY=your_gemini_api_key_here
# Use Gemini 2.5 (2.0 is retired)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro

JWT_SECRET=change-me-to-a-long-random-string
FREE_SCANS_PER_MONTH=1
PLUS_PRICE_INR=249
PLUS_YEARLY_INR=1999

# Sign-in protection: lock an account after this many failed attempts
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Signed-out teaser: free previews allowed per address before signing up
MAX_PREVIEWS_PER_WINDOW=3
PREVIEW_WINDOW_MINUTES=60
PREVIEW_COLOR_COUNT=3

# Speed limit on every route that calls Google's AI, per signed-in user.
# Separate from the monthly free-scan allowance, and it applies to paying
# users too — it exists to stop one account running up a large bill quickly.
AI_REQUESTS_PER_HOUR=10
# Paying subscribers get a higher ceiling — Plus promises unlimited checks,
# which means no monthly cap, not no burst protection.
AI_REQUESTS_PER_HOUR_PLUS=60
AI_RATE_WINDOW_MINUTES=60

# Which websites may call this API from a browser. Comma separated, no spaces,
# and each one must include http:// or https:// and the port if there is one.
# The default below is local development only, so a new deployment is closed
# until you set this. The phone app is unaffected — it is not a browser.
# Live example: ALLOWED_ORIGINS=https://glamgenius.in,https://www.glamgenius.in
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Frontend only (safe to expose — public API base URL)
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Invite-only private test
ADMIN_SECRET=change-me-admin-secret
INVITE_SCANS_PER_MONTH=50
INVITE_ONLY=true


# =========================================================================
# V2 settings (Phase 1). MongoDB above is untouched and still runs V1.
# =========================================================================

# --- PostgreSQL ---------------------------------------------------------
# V2 data only: media, consent, AI run records, audit, usage. The driver must
# be asyncpg — the app and Alembic are both async.
POSTGRES_URL=postgresql+asyncpg://glamgenius:glamgenius@postgres:5432/glamgenius_v2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
# Logs every SQL statement. Useful when debugging, very noisy otherwise.
POSTGRES_ECHO=false

# --- Feature flags ------------------------------------------------------
# Comma-separated list of V2 modules to switch on at boot. Empty means a fresh
# deployment exposes nothing new, which is the safe default. The feature_flags
# table overrides this at runtime, without a redeploy.
# Available: v2_media, v2_privacy, v2_consent, v2_ai_gateway
V2_FEATURES=

# --- Billing ------------------------------------------------------------
# THE source of truth for whether the app may offer anything for sale. While
# this is false, the app hides every payment button and the API refuses to
# create an order. Keep it false for the whole private beta.
SUBSCRIPTIONS_AVAILABLE=false

# --- Media storage ------------------------------------------------------
# 'local' writes to disk (development). 's3' talks to any S3-compatible
# service (R2, S3, Spaces, MinIO) and additionally needs the boto3 package,
# which is deliberately not installed yet.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=/data/media
# 8 MB. Uploads above this are refused while still streaming, not after.
MEDIA_MAX_BYTES=8388608
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# Only needed when MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Consent ------------------------------------------------------------
# Ships OFF. Turning it on before the app has collected answers would lock
# every existing account out of photo analysis. Switch it on once enough
# accounts have a recorded answer.
REQUIRE_ANALYSIS_CONSENT=false
# Change this when the consent wording changes. Agreement to old wording then
# stops counting and users are asked again.
CONSENT_VERSION=2026-08-01

# --- AI gateway ---------------------------------------------------------
# A hanging provider must fail, not hold a request open forever.
AI_TIMEOUT_SECONDS=45
# Rough per-1K-token prices, used only to estimate spend in the ai_runs table.
# Not billing. Update when Google changes pricing.
AI_COST_PER_1K_INPUT_USD=0.0003
AI_COST_PER_1K_OUTPUT_USD=0.0025

# --- Request limits -----------------------------------------------------
# A base64 image arrives as a JSON string. Without a ceiling one request can
# push an arbitrarily large payload to a paid provider. ~12M characters is
# roughly a 9 MB image.
MAX_IMAGE_BASE64_CHARS=12000000
