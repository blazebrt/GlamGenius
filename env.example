# GlamGenius — Personal Stylist & Skin/Hair Wellness Coach
# Copy to backend/.env (NEVER commit real secrets)

MONGO_URL=mongodb://mongo:27017
DB_NAME=glamgenius

# Server-side only — do NOT put this in frontend or EXPO_PUBLIC_* vars
GEMINI_API_KEY=your_gemini_api_key_here
# Use Gemini 2.5 (2.0 is retired)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro

JWT_SECRET=change-me-to-a-long-random-string
FREE_SCANS_PER_MONTH=1
PLUS_PRICE_INR=249
PLUS_YEARLY_INR=1999

# Sign-in protection: lock an account after this many failed attempts
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Signed-out teaser: free previews allowed per address before signing up
MAX_PREVIEWS_PER_WINDOW=3
PREVIEW_WINDOW_MINUTES=60
PREVIEW_COLOR_COUNT=3

# Frontend only (safe to expose — public API base URL)
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
