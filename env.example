# GlamGenius — Personal Appearance Operating System
# Copy to backend/.env. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Public anon JWT. Safe to expose to the frontend.
SUPABASE_ANON_KEY=your_anon_key_here
# SERVER-ONLY. Never expose to the frontend or ship in Expo bundles.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT issuer used in access tokens. Defaults to ${SUPABASE_URL}/auth/v1 when empty.
SUPABASE_JWT_ISSUER=
# JWKS endpoint for asymmetric (RS256/ES256) verification. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when empty.
SUPABASE_JWKS_URL=

# Private bucket that holds inventory media.
SUPABASE_STORAGE_BUCKET=glamgenius-media

# Sync + async URL for the same Supabase Postgres. Both are supported by
# the app; Alembic uses the sync driver, runtime uses asyncpg.
# Direct: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_URL=postgresql://postgres:change_me@db.your-project.supabase.co:5432/postgres
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_ECHO=false

# ---------------------------------------------------------------------------
# Optional admin bootstrap
# ---------------------------------------------------------------------------
# Comma-separated list of Supabase Auth user UUIDs treated as admins. The
# first user should be created through the Supabase dashboard, then their
# UUID added here.
SUPABASE_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro

# ---------------------------------------------------------------------------
# CORS + observability
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Consent
# ---------------------------------------------------------------------------
REQUIRE_ANALYSIS_CONSENT=true
CONSENT_VERSION=2026-01-01

# ---------------------------------------------------------------------------
# Beta usage controls (NON-PAYMENT abuse & cost limits)
# ---------------------------------------------------------------------------
# GlamGenius is a private beta. These are cost & abuse controls, NOT plans.
# Failed AI work is not counted. Idempotent retries are not double-counted.
BETA_AI_REQUESTS_PER_HOUR=60
BETA_SCAN_LIMIT_PER_MONTH=60
BETA_STYLE_LIMIT_PER_MONTH=60
BETA_SHOPPING_CHECK_LIMIT_PER_MONTH=60

# ---------------------------------------------------------------------------
# Invite-only access
# ---------------------------------------------------------------------------
# When "true", registration requires a valid invite code. Setting this to
# "false" in development lets you sign up freely; the production default
# stays true.
INVITE_REQUIRED=true

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Production: supabase. Tests: local.
MEDIA_STORAGE_BACKEND=supabase
# Escape hatch for local-disk media in a production tier. Leave false.
MEDIA_ALLOW_LOCAL_IN_PRODUCTION=false
MEDIA_LOCAL_ROOT=/data/media
MEDIA_MAX_BYTES=8388608
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp
# TTL of a signed download URL, in seconds.
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Customer-facing links (required in production)
# ---------------------------------------------------------------------------
# Production refuses to start while these are placeholders. They are shown to
# customers, so they must be real, reachable pages.
PRIVACY_POLICY_URL=https://glamgenius.placeholder/privacy
SUPPORT_URL=https://glamgenius.placeholder/support

# ---------------------------------------------------------------------------
# Open Food Facts (Store A) — see docs/architecture/ODBL_DATA_WALL.md
# ---------------------------------------------------------------------------
# Open Food Facts data is ODbL licensed and carries a share-alike clause.
# Combining it with our own data into one database would legally oblige us to
# publish the combined database — the whole product — openly.
#
# This URL is what keeps the two stores physically apart. Point it at a
# separate database, ideally on separate hardware. Left empty, Store A falls
# back to the application database: acceptable in development, and the app
# logs a warning so it is never a silent choice.
OFF_DATABASE_URL=

# Open Food Facts asks every API caller to identify itself. Set a real contact
# address: anonymous traffic is rate-limited or blocked.
OFF_APP_NAME=GlamGenius
OFF_APP_VERSION=1.0
OFF_CONTACT_EMAIL=
OFF_TIMEOUT_SECONDS=4.0

# Where the ODbL export job writes the redistributable dataset.
OFF_EXPORT_DIR=/data/off-export

# ---------------------------------------------------------------------------
# Notification worker (hourly batch — see docs/OPERATIONS.md section 6)
# ---------------------------------------------------------------------------
# The worker is invoked by the host scheduler, not by this application. Nothing
# here installs a schedule; these two settings only make testing it safe.
#
# "live"    — pushes are delivered. The production setting.
# "dry_run" — every push is dropped inside push.send(); no socket is opened, so
#             nothing can reach a device. Production and staging refuse to start
#             with this set, so it cannot be left on by accident.
PUSH_DELIVERY_MODE=live
#
# Accounts that may be targeted by a manual run
# (python -m app.workers.notifications --account <uuid>). Comma-separated.
# Empty means manual runs are refused outright — which is the safe default,
# because it makes "test the worker by hand" unable to notify real customers.
NOTIFICATION_TEST_ACCOUNT_IDS=

# ---------------------------------------------------------------------------
# Google Calendar (optional, read-only, off by default)
# ---------------------------------------------------------------------------
# Leave GOOGLE_CALENDAR_ENABLED=false and the rest empty to run without it;
# manual events remain fully supported. When true, every value below is
# required and the credential store must be supabase_vault.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Google Cloud console.
GOOGLE_CALENDAR_REDIRECT_URI=
# Fixed deep link the callback returns to. No query string, no fragment.
GOOGLE_CALENDAR_APP_RETURN_URI=glamgenius://calendar-result
# Refresh tokens live in Supabase Vault; the database keeps only an opaque
# reference. There is deliberately no plaintext fallback.
GOOGLE_CALENDAR_CREDENTIAL_STORE=disabled
GOOGLE_CALENDAR_STATE_TTL_SECONDS=600
GOOGLE_CALENDAR_INITIAL_HORIZON_DAYS=90
GOOGLE_CALENDAR_TIMEOUT_SECONDS=8.0

# ---------------------------------------------------------------------------
# Live environment: weather and air quality (optional, off by default)
# ---------------------------------------------------------------------------
# Empty disables live weather and AQI; the planner falls back to regional
# climate reasoning and never invents a forecast.
LIVE_ENVIRONMENT_PROVIDER=
# disabled | evaluation | commercial. Staging and production reject
# "evaluation"; "commercial" requires OPEN_METEO_API_KEY.
OPEN_METEO_MODE=disabled
OPEN_METEO_API_KEY=
OPEN_METEO_TIMEOUT_SECONDS=5.0
ENVIRONMENT_CACHE_TTL_SECONDS=3600
ENVIRONMENT_STALE_MAX_SECONDS=21600

# ---------------------------------------------------------------------------
# Deployment tier
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Comma-separated flag keys switched on at boot. The database table
# overrides these at runtime.
V2_FEATURES=v2_profile,v2_scan,v2_quiz,v2_inventory,v2_recommendations,v2_shopping_decisions,v2_today,v2_planner,v2_routines,v2_progress,v2_media,v2_privacy,v2_consent,v2_ai_gateway


# ---------------------------------------------------------------------------
# Expo / frontend
# ---------------------------------------------------------------------------
# These live in `frontend/.env`, not `backend/.env`, because they must be
# baked into the Expo bundle. Only public values ship here — never the
# service-role key.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Native push additionally needs an EAS project id, which is not an
# environment variable: it is `expo.extra.eas.projectId` in
# `frontend/app.json`, written by `eas init`. Until it exists the in-app
# control refuses to enable notifications rather than pretending it worked.
# The backend never reads it and does not require it to start.
