# GlamGenius — Personal Stylist & Skin/Hair Wellness Coach
# Copy to backend/.env (NEVER commit real secrets)

MONGO_URL=mongodb://mongo:27017
DB_NAME=glamgenius

# Server-side only — do NOT put this in frontend or EXPO_PUBLIC_* vars
GEMINI_API_KEY=your_gemini_api_key_here
# Use Gemini 2.5 (2.0 is retired)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro

JWT_SECRET=change-me-to-a-long-random-string
FREE_SCANS_PER_MONTH=1
PLUS_PRICE_INR=249
PLUS_YEARLY_INR=1999

# Sign-in protection: lock an account after this many failed attempts
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Signed-out teaser: free previews allowed per address before signing up
MAX_PREVIEWS_PER_WINDOW=3
PREVIEW_WINDOW_MINUTES=60
PREVIEW_COLOR_COUNT=3

# Speed limit on every route that calls Google's AI, per signed-in user.
# Separate from the monthly free-scan allowance, and it applies to paying
# users too — it exists to stop one account running up a large bill quickly.
AI_REQUESTS_PER_HOUR=10
# Paying subscribers get a higher ceiling — Plus promises unlimited checks,
# which means no monthly cap, not no burst protection.
AI_REQUESTS_PER_HOUR_PLUS=60
AI_RATE_WINDOW_MINUTES=60

# Which websites may call this API from a browser. Comma separated, no spaces,
# and each one must include http:// or https:// and the port if there is one.
# The default below is local development only, so a new deployment is closed
# until you set this. The phone app is unaffected — it is not a browser.
# Live example: ALLOWED_ORIGINS=https://glamgenius.in,https://www.glamgenius.in
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Frontend only (safe to expose — public API base URL)
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
